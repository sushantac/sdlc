# ==============================================================================
# E-Commerce Platform — Environment Configuration Template
# Copy to: cp .env.example .env
# ==============================================================================

# ===== Database =====
POSTGRES_DB=ecommerce
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=secret
DB_HOST=localhost
DB_PORT=5432

# ===== Spring Boot =====
SPRING_PROFILES_ACTIVE=dev
# Comma-separated internal API keys for service-to-service auth
INTERNAL_API_KEY=internal-service-key-12345

# ===== JWT =====
JWT_SECRET=replace-with-a-256-bit-secret-in-production
JWT_ACCESS_TOKEN_EXPIRATION=900          # 15 minutes (seconds)
JWT_REFRESH_TOKEN_EXPIRATION=604800      # 7 days (seconds)

# ===== Gateway =====
CORS_ALLOWED_ORIGINS=http://localhost:3000
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=100

# ===== Kafka =====
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_REPLICATION=1
KAFKA_RETENTION_HOURS=168
KAFKA_AUTO_CREATE_TOPICS=true

# ===== Redis =====
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ===== Frontend =====
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
NODE_ENV=development

# ===== Monitoring =====
GRAFANA_ADMIN_PASSWORD=admin
JAEGER_AGENT_PORT=6831
JAEGER_COLLECTOR_ENDPOINT=http://jaeger:14268

# ===== SDLC Tools =====
PLANE_DB_PASSWORD=plane_secret
BOOKSTACK_DB_PASSWORD=bookstack_secret
PENPOT_DB_PASSWORD=penpot_secret

# ===== Docker images (leave blank for auto) =====
DOCKER_REGISTRY=
DOCKER_USERNAME=
DOCKER_PASSWORD=